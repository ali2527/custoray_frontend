Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteRule ^$ /index.html [L]
    RewriteRule ^store/([^/]+)/?$ /store/index.html [L]
    RewriteRule ^customers/([0-9]+)/timeline/?$ /customers/timeline/index.html [L]
    RewriteRule ^employees/([0-9]+)/edit/?$ /employees/edit/index.html [L]
    RewriteRule ^employees/([0-9]+)/?$ /employees/detail/index.html [L]
    RewriteRule ^documents/invoice-templates/preview/([^/]+)/?$ /documents/invoice-templates/preview/index.html [L]
    RewriteRule ^inventory/terms/([^/]+)/?$ /inventory/terms/detail/index.html [L]
    RewriteRule ^dashboard/?$ /home/index.html [L]
    RewriteRule ^dashboard/(.+)$ /$1 [L]

    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-l
    RewriteRule . /index.html [L]
</IfModule>
